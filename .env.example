# CIA Luxury Fleets — environment variables
#
# The booking form works WITHOUT any of these: it always falls back to a
# WhatsApp deep-link. Add a Resend key to also receive booking emails.

# Resend (https://resend.com) — optional. Without it, the /api/booking
# route returns gracefully and the form still routes the lead to WhatsApp.
RESEND_API_KEY=

# Where booking emails are delivered (your inbox).
BOOKING_TO_EMAIL=bookings@cialuxuryfleets.com

# Verified Resend sender. Must be a domain you've verified in Resend,
# or use onboarding@resend.dev for testing.
BOOKING_FROM_EMAIL=onboarding@resend.dev

# Public site URL (used for canonical + OpenGraph). No trailing slash.
NEXT_PUBLIC_SITE_URL=https://cialuxuryfleets.com
